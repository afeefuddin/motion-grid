{
  "name": "motiongrid",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @motiongrid/web",
    "dev:web": "npm run dev --workspace @motiongrid/web",
    "dev:agents": "npm run dev --workspace @motiongrid/agent-runtime",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  }
}
