{
  "name": "motiongrid",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --dir apps/web dev",
    "build": "pnpm typecheck && pnpm --dir apps/web build",
    "typecheck": "tsc --noEmit",
    "check": "biome check package.json tsconfig.json next.config.ts biome.json drizzle.config.ts src/contracts src/db/schema.ts src/mastra/index.ts src/sim/*.ts src/adapters/sim",
    "check:write": "biome check --write package.json tsconfig.json next.config.ts biome.json drizzle.config.ts src/contracts src/db/schema.ts src/mastra/index.ts src/sim/*.ts src/adapters/sim",
    "contracts:smoke": "tsx src/contracts/smoke.ts",
    "sim:generate": "tsx src/sim/generate.ts",
    "sim:test": "tsx src/adapters/sim/adapters.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.16.0",
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@mastra/client-js": "1.38.0",
    "@mastra/core": "1.57.0",
    "@mastra/pg": "1.19.0",
    "drizzle-orm": "0.45.2",
    "drizzle-zod": "0.8.3",
    "lucide-react": "1.30.0",
    "next": "16.3.0",
    "postgres": "3.4.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.7",
    "@faker-js/faker": "10.1.0",
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "drizzle-kit": "0.31.10",
    "tailwindcss": "4.1.14",
    "tsx": "4.20.6",
    "typescript": "7.0.2"
  }
}
