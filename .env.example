# Application and Mastra storage database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/motiongrid

# Model router provider.
ANTHROPIC_API_KEY=

# WhatsApp delivery through the hosted whatsapp-web.js service.
WHATSAPP_SERVICE_URL=https://wp.example.com
WHATSAPP_SERVICE_API_KEY=
WHATSAPP_FROM=+919876543210
WHATSAPP_TO=+919876543210
WHATSAPP_ALLOWED_RECIPIENTS=+919876543210

# Optional Twilio webhook validation for the legacy inbound routes.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Email delivery through Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=MotionGrid <onboarding@resend.dev>
RESEND_TO_EMAIL=delivered@resend.dev
RESEND_ALLOWED_RECIPIENTS=delivered@resend.dev
RESEND_WEBHOOK_SECRET=

# Public origin used to construct Twilio and Resend webhook URLs.
PUBLIC_WEBHOOK_URL=
