# Application and Mastra storage database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/motiongrid

# Model router provider.
ANTHROPIC_API_KEY=

# WhatsApp delivery through Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_ALLOWED_RECIPIENTS=+919876543210

# Email delivery through Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=MotionGrid <onboarding@resend.dev>
RESEND_ALLOWED_RECIPIENTS=delivered@resend.dev
RESEND_WEBHOOK_SECRET=

# Public origin used to construct Twilio and Resend webhook URLs.
PUBLIC_WEBHOOK_URL=
