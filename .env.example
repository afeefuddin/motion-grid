# Shared application database. Domain records remain the source of truth.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/motiongrid

# Next.js -> Mastra server connection. Keep this server-only.
MASTRA_API_URL=http://localhost:4111

# Model provider
OPENAI_API_KEY=

# Mastra development snapshot storage
MASTRA_STORAGE_URL=file:./motiongrid-mastra.db

# Integration placeholders
OUTSCRAPER_API_KEY=
