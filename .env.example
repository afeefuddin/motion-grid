# Required by both the Next.js app and the Mastra runtime.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/motiongrid

# The Next.js app calls this Mastra endpoint. The local default is used when unset.
MASTRA_API_URL=http://localhost:4111

# Required by the Mastra campaign agents and generated-market cache misses.
ANTHROPIC_API_KEY=
# Optional override for generated-market cache misses; defaults to Claude Sonnet 4.6.
ANTHROPIC_GENERATED_MARKET_MODEL=claude-sonnet-4-6

# WhatsApp delivery through the hosted whatsapp-web.js service.
WHATSAPP_SERVICE_URL=https://wp.example.com
WHATSAPP_SERVICE_API_KEY=
WHATSAPP_FROM=+919876543210
# Optional controlled-demo override. When set, every approved WhatsApp draft goes here instead
# of the contact address; it must also appear in WHATSAPP_ALLOWED_RECIPIENTS.
WHATSAPP_TO=+919876543210
# App-side allowlist. Configure the hosted WhatsApp service's ALLOWED_RECIPIENTS separately.
WHATSAPP_ALLOWED_RECIPIENTS=+919876543210

# Optional Twilio webhook validation for the legacy inbound routes.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Email delivery through Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=MotionGrid <onboarding@resend.dev>
# Optional controlled-demo override. When set, every approved email draft goes here instead of
# the contact address; it must also appear in RESEND_ALLOWED_RECIPIENTS.
RESEND_TO_EMAIL=delivered@resend.dev
RESEND_ALLOWED_RECIPIENTS=delivered@resend.dev
RESEND_WEBHOOK_SECRET=

# Public origin used to construct Twilio and Resend webhook URLs.
PUBLIC_WEBHOOK_URL=
