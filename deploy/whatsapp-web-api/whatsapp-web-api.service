[Unit]
Description=MotionGrid WhatsApp Web API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=whatsapp-api
Group=whatsapp-api
WorkingDirectory=/opt/whatsapp-web-api
EnvironmentFile=/etc/whatsapp-web-api.env
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/whatsapp-web-api

[Install]
WantedBy=multi-user.target
