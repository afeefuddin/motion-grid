{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./apps/web/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "apps/web/next-env.d.ts",
    "apps/web/**/*.ts",
    "apps/web/**/*.tsx",
    "drizzle.config.ts",
    "apps/web/next.config.ts"
  ],
  "exclude": ["node_modules", "apps/web/.next"]
}
